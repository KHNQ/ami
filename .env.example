# Copy to .env and fill in real values before deploying. See src/config.js
# for how each of these is read/defaulted.

NODE_ENV=production
PORT=3000

# --- Storage ---
# Only "sqlite" is implemented today (see src/db/adapters).
DB_ENGINE=sqlite
SQLITE_FILE=trex.sqlite

# --- Auth ---
# Required in production; boot refuses to start without a strong, unique
# value (see the guard in src/config.js). Generate with e.g.
# `openssl rand -base64 48`.
JWT_SECRET=
JWT_EXPIRY_SECONDS=604800

# --- Email (Resend) ---
# Required in production so password reset links actually get delivered
# (see src/services/emailService.js). Without it set, forgotPassword falls
# back to logging the link to the console -- fine for dev, refused at boot
# in production.
RESEND_API_KEY=
EMAIL_FROM="Trex <no-reply@yourdomain.com>"

# --- Frontend / links ---
FRONTEND_BASE_URL=https://app.yourdomain.com
# Both apps are separate origins: the storefront and the admin control room.
# In dev these default to localhost:5173 and localhost:5174.
CORS_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# --- Financial defaults for new commission plans (all basis points, 10000 = 100%) ---
DEFAULT_PAYOUT_POOL_PCT_BP=6500
DEFAULT_RESERVE_PCT_BP=1000
DEFAULT_MIN_MARGIN_CENTS=100
DEFAULT_MAX_PAYOUT_DEPTH=6
DEFAULT_ACTIVITY_PERIOD_DAYS=30
DEFAULT_ACTIVITY_MIN_PV_CENTS=2000
DEFAULT_DECAY_INACTIVE_DAYS=60
DEFAULT_DECAY_PCT_PER_PERIOD_BP=1000
COMMISSION_HOLD_DAYS=14
DEFAULT_RANK_BONUS_POOL_PCT_BP=0

# --- Jobs ---
ENABLE_CRON_JOBS=false

# --- Shared key/value store (optional, see src/lib/kv.js) ---
# Unset = in-memory driver, which is correct for a single instance (and the
# SQLite engine constrains this deployment to one writer anyway). Set it when
# running more than one process, otherwise each instance keeps its own rate
# limit counters and every client gets one full allowance per instance.
#
# NOTE: this uses Bun's built-in Redis client, added in Bun 1.2.9. On older
# Bun the app logs a warning at startup and stays in-memory -- setting this
# does nothing there.
# REDIS_URL=redis://localhost:6379

# --- Seeding (dev/test only -- scripts/seed.js refuses to run in
# production unless this is explicitly set) ---
# ALLOW_SEED_IN_PRODUCTION=1
# SEED_ADMIN_EMAIL=admin@trex.local
# SEED_ADMIN_PASSWORD=admin12345

# --- Outbound SMS (optional, see src/services/smsService.js) ---
# Twilio does not serve Iran, so the supported providers are domestic ones.
# No key = log instead of send (same fallback as email).
# SMS_PROVIDER=kavenegar        # kavenegar | smsir
# SMS_API_KEY=
# SMS_SENDER=
COMPANY_NAME=Ashkan Medical Idea

# --- Uploads (CV attachments from the careers form) ---
# Kept on disk rather than in SQLite. In Docker, point this at the same
# mounted volume as SQLITE_FILE so applications survive a restart.
UPLOAD_DIR=./data/uploads

# --- AI assistant (src/services/aiService.js) ---
# Server-side ONLY. There is deliberately no VITE_-prefixed equivalent:
# Vite inlines any VITE_* variable into the client bundle, which would ship
# this credential to every visitor. All model calls are proxied through /ai/*.
DEEPSEEK_API_KEY=
# Override to point at a compatible endpoint (or a local stub) if needed.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_MAX_TOKENS=700

# The whole assistant, as one switch, and it ships OFF.
#
# With this unset: /ai/* answers 503 from a stub router, none of the
# assistant's services or tools are imported at boot, /site-config reports
# ai_chat_enabled false, and the storefront never downloads the chat bundle.
# It also beats the `ai_chat_enabled` setting in the admin console -- a kill
# switch an operator can undo from a web form is not a kill switch.
#
# To turn it back on: set this to true, restart, and leave the admin toggle
# on (its default). Nothing was deleted; sessions, attachments and the tool
# audit trail are all still in the database.
AI_ENABLED=false

# --- The agent (src/services/agent/) ---
# A signed-in visitor gets a tool-calling agent; an anonymous one gets the
# retrieval assistant above, unchanged, as a teaser.
#
# Steps are model -> tools -> model rounds. The last one is forced to answer,
# so five is "retrieve, search, read, act, answer" and not an escape hatch.
AI_AGENT_MAX_STEPS=5
AI_AGENT_TIMEOUT_MS=60000
AI_TOOL_TIMEOUT_MS=8000

# How many messages a signed-in customer may send per calendar day, and which
# calendar that is. LEAVE UTC AT YOUR PERIL for an Iranian deployment: at UTC
# everyone's allowance resets at half past three in the afternoon, which reads
# to the user as the quota refilling at random.
AI_DAILY_PROMPT_LIMIT=20
AI_QUOTA_TIMEZONE=UTC
# The anonymous teaser, per IP per hour. Small on purpose: it exists to show
# what the assistant does, not to serve someone indefinitely without an account.
AI_ANON_HOURLY_LIMIT=5
# Exa bills per search, and a model handed a search tool will use it happily.
AI_WEB_SEARCH_DAILY_MAX=40

# --- Exa web search (src/services/exaService.js) ---
# An ARRAY, comma-separated, rotated on failure: a revoked or rate-limited key
# degrades to the next rather than taking web search down. The singular name is
# accepted too, so a one-key deployment needs no rename. With NEITHER set, the
# web tools are simply not registered and the agent behaves as if it has no web
# access -- no crash, no error path.
EXA_API_KEYS=
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai

# --- Files the visitor sends the assistant ---
# The cap is on DECODED bytes; a base64 data URL is about a third larger on the
# wire. Images are downscaled in the browser first, so a phone photograph
# usually arrives well under this.
AI_MAX_ATTACHMENT_BYTES=5000000
AI_MAX_ATTACHMENTS_PER_MESSAGE=4
# How many turns back an image is re-sent in full. Each one costs 1-2k tokens
# on EVERY turn it stays in the array; older ones degrade to a one-line mention
# that the `view_attachment` tool can reopen on demand.
AI_ATTACHMENT_HISTORY_TURNS=2

# --- Links ---
# Where the API is reachable from outside. The proforma download link goes in
# an email, where a relative path means nothing.
API_BASE_URL=http://localhost:3000
# Who is emailed when somebody asks for a price. Unset means nobody is, and
# the Proformas queue in the admin console is the only signal -- which is a real
# queue someone watches, not a dropped message.
SALES_INBOX_EMAIL=

# --- Email verification (link-based, uses RESEND_API_KEY above) ---
EMAIL_VERIFICATION_TTL_HOURS=48

# --- Instagram feed for /socials ---
# Instagram has no key-free API. Without this the page renders a link to the
# real profile rather than fabricating posts (see src/services/socialService.js).
INSTAGRAM_ACCESS_TOKEN=

# The assistant's background knowledge is crawled from the live site into
# content/ashkan-medical/site-corpus.json by `bun run crawl`, and injected
# into the system prompt. Re-run it when the website's copy changes.
